#!/bin/bash
# On work machines, writes the [work-us] profile (Axelerant US account
# 558147955244, IAM user hussain) into ~/.aws/credentials from 1Password.
# Every other profile in the file is hand-managed and passes through as it is;
# only an existing [work-us] section is replaced. Other machines get the file
# back unchanged.
set -euo pipefail

{{ if .work -}}
# Drop any existing [work-us] section and trailing blank lines.
existing=$(awk '
    /^[[:space:]]*\[/ { skip = ($0 ~ /^[[:space:]]*\[work-us\][[:space:]]*$/) }
    !skip { lines[++n] = $0 }
    END {
        while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
        for (i = 1; i <= n; i++) print lines[i]
    }')

if [ -n "$existing" ]; then
    printf '%s\n\n' "$existing"
fi
cat <<'EOF'
[work-us]
aws_access_key_id = {{ onepasswordRead "op://Employee/AWS Axelerant US/AWS CLI/access key id" "axelerant.1password.com" }}
aws_secret_access_key = {{ onepasswordRead "op://Employee/AWS Axelerant US/AWS CLI/secret access key" "axelerant.1password.com" }}
EOF
{{- else }}
cat
{{- end }}

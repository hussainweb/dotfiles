#!/bin/bash
# Writes the AWS profiles in .chezmoidata/aws.yaml into ~/.aws/credentials on
# work machines, with keys read from 1Password. Hand-written sections pass
# through as they are; see the data file for which sections are replaced.
# Non-work machines get only the managed sections removed.
set -euo pipefail

{{ $names := "" -}}
{{ if .work }}{{ $names = keys .aws.profiles | sortAlpha | join " " }}{{ end -}}
out=$({{ template "aws-strip-managed.sh" $names }})
{{- if .work }}
{{-   $account := .aws.op_account }}
{{-   range $name, $p := .aws.profiles }}

section=$(cat <<'EOF_SECTION'
[{{ $name }}]
# managed by chezmoi (.chezmoidata/aws.yaml)
aws_access_key_id = {{ onepasswordRead $p.access_key_id $account }}
aws_secret_access_key = {{ onepasswordRead $p.secret_access_key $account }}
EOF_SECTION
)
out=${out:+$out$'\n\n'}$section
{{-   end }}
{{- end }}

if [ -n "$out" ]; then
    printf '%s\n' "$out"
fi

#!/bin/bash

# .chezmoidata/skills.yaml hash: {{ include ".chezmoidata/skills.yaml" | sha256sum }}

# Exit on error
set -e

{{ if and .agents .global_skills -}}
if command -v npx &> /dev/null; then
    echo "Installing global skills..."
    
    # Pi and other universal agents read ~/.agents/skills, where every install
    # lands, so they need no entry here.
    TARGET_AGENTS="hermes-agent"
    {{ if .development -}}
    TARGET_AGENTS="$TARGET_AGENTS antigravity antigravity-cli warp zed"
    {{- end }}
    {{ if and .development .work -}}
    TARGET_AGENTS="$TARGET_AGENTS claude-code"
    {{- end }}

    {{ range .global_skills -}}
    npx -y skills add {{ .repo }}{{ if hasKey . "skills" }} --skill {{ join " " .skills }}{{ end }} --agent $TARGET_AGENTS -y -g || true
    {{ end }}
fi
{{- end }}

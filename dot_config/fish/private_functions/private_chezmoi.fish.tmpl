function chezmoi --wraps chezmoi --description "Chezmoi with automatic 1Password authentication"
{{- if not .macos }}
    if type -q op
        for arg in $argv
            switch $arg
                case update apply diff init
                    set -l accounts
                    {{ if .personal -}}
                    set -a accounts "my.1password.com"
                    {{- end }}
                    {{ if .work -}}
                    set -a accounts "axelerant.1password.com"
                    {{- end }}

                    set -l env_args
                    for account in $accounts
                        set -l uuid
                        if command -sq jq
                            set uuid (op account list --format json 2>/dev/null | jq -r ".[] | select(.url | contains(\"$account\")) | .account_uuid" 2>/dev/null)
                        end
                        if test -z "$uuid"
                            set uuid (grep -A 2 -i "$account" ~/.config/op/config 2>/dev/null | grep -i "accountUUID" | head -n1 | string match -rg '"accountUUID":\s*"([^"]+)"')
                        end

                        set -l shorthand (string split -m 1 . $account)[1]
                        set -l safe_account (string replace -a . _ $account)
                        set -l token

                        # Check if an existing session token is already valid for this specific account
                        for vname in "OP_SESSION_$uuid" "OP_SESSION_$safe_account" "OP_SESSION_$shorthand" OP_SESSION
                            if test -n "$$vname"
                                if env "OP_SESSION_$account=$$vname" "OP_SESSION_$safe_account=$$vname" "OP_SESSION_$shorthand=$$vname" op account get --account "$account" >/dev/null 2>&1
                                    set token $$vname
                                    break
                                end
                            end
                        end

                        # If not signed in or session expired, prompt for raw token
                        if test -z "$token"
                            echo "Signing in to 1Password ($account)..."
                            set token (op signin --account "$account" --raw)
                        end

                        if test -n "$token"
                            if test -n "$uuid"
                                set -gx "OP_SESSION_$uuid" $token
                                set -a env_args "OP_SESSION_$uuid=$token"
                            end
                            set -gx "OP_SESSION_$shorthand" $token
                            set -gx "OP_SESSION_$safe_account" $token
                            set -a env_args "OP_SESSION_$account=$token"
                            set -a env_args "OP_SESSION_$safe_account=$token"
                            set -a env_args "OP_SESSION_$shorthand=$token"
                        end
                    end

                    env $env_args chezmoi $argv
                    return $status
            end
        end
    end
{{- end }}

    command chezmoi $argv
end

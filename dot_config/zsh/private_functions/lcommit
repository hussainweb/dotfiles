local diff=$(git diff --cached)
if [[ -z "$diff" ]]; then
    echo "No staged changes found."
    return 1
fi

local context="$*"
local system_prompt='Write a concise, conventional commit-style message describing these changes. Use the proper type: feat, fix, chore, ci, docs, refactor, style, or test.

For example:
- use chore for dependency updates.
- use ci for changes to GitHub Actions or other pipelines.
- and so on.
'

if [[ -n "$context" ]]; then
    system_prompt="$system_prompt
Additional context: $context"
fi

local msg=$(echo "$diff" | llm --system "$system_prompt")
printf "%s\n" "$msg"

local copied=0
if [[ -z "$SSH_TTY" && -z "$SSH_CLIENT" && -z "$SSH_CONNECTION" ]]; then
    if command -v pbcopy > /dev/null 2>&1; then
        printf "%s" "$msg" | pbcopy
        copied=1
    elif command -v wl-copy > /dev/null 2>&1; then
        printf "%s" "$msg" | wl-copy
        copied=1
    elif command -v xclip > /dev/null 2>&1; then
        printf "%s" "$msg" | xclip -selection clipboard
        copied=1
    elif command -v xsel > /dev/null 2>&1; then
        printf "%s" "$msg" | xsel --clipboard --input
        copied=1
    fi
fi

if [[ $copied -eq 0 ]]; then
    local b64=$(printf "%s" "$msg" | base64 | tr -d '\r\n')
    if [[ -n "$TMUX" ]]; then
        printf "\033Ptmux;\033\033]52;c;%s\a\033\\" "$b64" > /dev/tty 2>/dev/null || printf "\033Ptmux;\033\033]52;c;%s\a\033\\" "$b64"
    else
        printf "\033]52;c;%s\a" "$b64" > /dev/tty 2>/dev/null || printf "\033]52;c;%s\a" "$b64"
    fi
fi

{{- if not .macos }}
# Ensure required 1Password accounts are signed in before running commands
# that evaluate templates or lifecycle scripts on Linux/VMs.
if command -v op >/dev/null 2>&1; then
    for arg in "$@"; do
        case "$arg" in
            update|apply|diff|init)
                local -a accounts=()
                {{ if .personal -}}
                accounts+=("my.1password.com")
                {{- end }}
                {{ if .work -}}
                accounts+=("axelerant.1password.com")
                {{- end }}

                local -a env_args=()
                for account in "${accounts[@]}"; do
                    local uuid=""
                    if command -v jq >/dev/null 2>&1; then
                        uuid=$(op account list --format json 2>/dev/null | jq -r ".[] | select(.url | contains(\"$account\")) | .account_uuid" 2>/dev/null || true)
                    fi
                    if [[ -z "$uuid" ]]; then
                        uuid=$(grep -A 2 -i "$account" ~/.config/op/config 2>/dev/null | grep -i "accountUUID" | head -n1 | sed -E 's/.*"accountUUID":[[:space:]]*"([^"]+)".*/\1/' || true)
                    fi

                    local shorthand="${account%%.*}"
                    local safe_account="${account//./_}"
                    local token=""

                    # Check if an existing session token is already valid for this specific account
                    for vname in "OP_SESSION_${uuid}" "OP_SESSION_${safe_account}" "OP_SESSION_${shorthand}" OP_SESSION; do
                        local val="${(P)vname}"
                        if [[ -n "$val" ]]; then
                            if env "OP_SESSION_${account}=$val" "OP_SESSION_${safe_account}=$val" "OP_SESSION_${shorthand}=$val" op account get --account "$account" >/dev/null 2>&1; then
                                token="$val"
                                break
                            fi
                        fi
                    done

                    # If not signed in or session expired, prompt for raw token
                    if [[ -z "$token" ]]; then
                        echo "Signing in to 1Password ($account)..."
                        token=$(op signin --account "$account" --raw)
                    fi

                    if [[ -n "$token" ]]; then
                        if [[ -n "$uuid" ]]; then
                            export "OP_SESSION_${uuid}=$token"
                            env_args+=("OP_SESSION_${uuid}=$token")
                        fi
                        export "OP_SESSION_${shorthand}=$token"
                        export "OP_SESSION_${safe_account}=$token"
                        env_args+=("OP_SESSION_${account}=$token")
                        env_args+=("OP_SESSION_${safe_account}=$token")
                        env_args+=("OP_SESSION_${shorthand}=$token")
                    fi
                done

                env "${env_args[@]}" command chezmoi "$@"
                return $?
                ;;
        esac
    done
fi
{{- end }}

command chezmoi "$@"

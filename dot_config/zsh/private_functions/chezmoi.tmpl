{{- if not .macos }}
# Ensure required 1Password accounts are signed in before running commands
# that evaluate templates or lifecycle scripts on Linux/VMs.
if command -v op >/dev/null 2>&1; then
    for arg in "$@"; do
        case "$arg" in
            update|apply|diff|init)
                local -a accounts=()
                {{ if .personal -}}
                accounts+=("my.1password.com")
                {{- end }}
                {{ if .work -}}
                accounts+=("axelerant.1password.com")
                {{- end }}

                for account in "${accounts[@]}"; do
                    local uuid=""
                    if command -v jq >/dev/null 2>&1; then
                        uuid=$(op account list --format json 2>/dev/null | jq -r ".[] | select(.url | contains(\"$account\")) | .account_uuid" 2>/dev/null || true)
                    fi
                    if [[ -z "$uuid" ]]; then
                        uuid=$(grep -A 2 -i "$account" ~/.config/op/config 2>/dev/null | grep -i "accountUUID" | head -n1 | sed -E 's/.*"accountUUID":[[:space:]]*"([^"]+)".*/\1/' || true)
                    fi

                    local shorthand="${account%%.*}"
                    local safe_account="${account//./_}"

                    if op account get --account "$account" >/dev/null 2>&1; then
                        # Account already signed in; ensure Chezmoi's UUID variable is also populated
                        if [[ -n "$uuid" && -z "${(P):-OP_SESSION_${uuid}}" ]]; then
                            for vname in "OP_SESSION_${safe_account}" "OP_SESSION_${shorthand}"; do
                                local val="${(P)vname}"
                                if [[ -n "$val" ]]; then
                                    export "OP_SESSION_${uuid}=$val"
                                    break
                                fi
                            done
                        fi
                    else
                        echo "Signing in to 1Password ($account)..."
                        local token
                        token=$(op signin --account "$account" --raw)
                        if [[ -n "$token" ]]; then
                            export "OP_SESSION_${shorthand}=$token"
                            export "OP_SESSION_${safe_account}=$token"
                            if [[ -n "$uuid" ]]; then
                                export "OP_SESSION_${uuid}=$token"
                            fi
                        fi
                    fi
                done
                break
                ;;
        esac
    done
fi
{{- end }}

command chezmoi "$@"

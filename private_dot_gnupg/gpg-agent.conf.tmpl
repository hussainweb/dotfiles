{{- if eq .chezmoi.os "darwin" -}}
{{- /* Probe only this arch's Homebrew prefix: on Apple Silicon /usr/local/bin
       can exist without being traversable, and stat then errors instead of
       returning false. */ -}}
{{- $brew_bin := ternary "/opt/homebrew/bin" "/usr/local/bin" (eq .chezmoi.arch "arm64") -}}
{{- if stat (joinPath $brew_bin "pinentry-mac") -}}
pinentry-program {{ joinPath $brew_bin "pinentry-mac" }}
{{- end }}
{{- else if eq .chezmoi.os "linux" -}}
{{- if stat "/home/linuxbrew/.linuxbrew/bin/pinentry" -}}
pinentry-program /home/linuxbrew/.linuxbrew/bin/pinentry
{{- else if stat "/usr/bin/pinentry" -}}
pinentry-program /usr/bin/pinentry
{{- end }}
{{- end }}

default-cache-ttl 86400
max-cache-ttl 86400
